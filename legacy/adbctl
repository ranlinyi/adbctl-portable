#!/usr/bin/env bash
# adbctl — Android 设备一键连接 / 投屏：有 USB 走 USB，没有才走无线调试
#
#   adbctl               # 自动选路：有 USB 就用 USB，否则连无线。stdout 只输出选中的序列号/地址
#   adbctl -S            # 连上后启动 scrcpy（参数见下方 SCRCPY_ARGS）
#   adbctl -a com.miui.calculator -S   # 只流转指定应用（虚拟显示，手机主屏不受影响）；-a 隐含 -S
#   adbctl -a 计算器 -S                # 模糊匹配：唯一命中直接用；多个则按匹配度列出序号让你选
#   adbctl -a +微信 -S                 # 前缀 + = 启动前先强杀该应用；? 前缀=模糊（本脚本默认就是模糊）
#   adbctl --list-apps                 # 列出设备上全部应用（应用名 + 包名）
#   adbctl -U            # 强制走 USB；当前没有在位 USB 设备则报错退出
#   adbctl -W            # 强制走无线（忽略在位的 USB）
#   adbctl -p 748966     # 无线配对（748966 = 手机上显示的 6 位配对码）；隐含 -W
#   adbctl -l            # 只列出无线候选地址，不做任何连接（无线专用）
#   adbctl -w 30         # 最多等 30 秒等 mDNS 广播出现（默认 0 = 只查一次）
#   adbctl -h            # 帮助
#
# 这个脚本会执行什么（副作用全部明列，只有这几条）:
#   * "$ADB" devices -l                    查询式，只读（判断有没有 USB）
#   * "$ADB" mdns services                 查询式，只读（仅无线路径）
#   * "$ADB" pair <配对地址> <配对码>      仅当给了 -p
#   * "$ADB" connect <候选地址>            仅无线路径，逐个候选试，成功即停
#   * scrcpy -s <选中的序列号/地址> --list-apps     仅当 --list-apps，或 -a 需要解析应用名时
#   * scrcpy -s <选中的序列号/地址> [--new-display --start-app=<包名>] $SCRCPY_ARGS
#                                            仅当给了 -S / -a
#   不写任何文件；不用 sudo；不扫端口；除 adb 自身的连接外不联网。
#
# 选路优先级:
#   -p / -l / -W  -> 无线
#   -U            -> USB（没有则退出码 1）
#   默认（无参数）-> 有 USB 设备就用 USB；没有才回落到无线
#   USB 判定依据：adb devices -l 中 state=device 且带 " usb:" 标记的那一行
#
# 环境变量:
#   ADB          指定 adb（默认 PATH 里的 adb）
#   PAIR_IP      指定取配对地址的命令（默认 pair_ip；找不到则自己解析）
#   SCRCPY_ARGS  覆盖 -S 时的 scrcpy 启动参数（默认见下方 SCRCPY_ARGS_DEFAULT）
#
# scrcpy 档位参考（2026-09-21 实测于 Redmi K70 / 540x1200 / H.265）:
#   默认档（本文件已设为默认）：VBR 上限 12M + 52fps + 缓冲 0 + 音频转发到电脑
#      VBR 内容自适应：静态界面降到零点几 Mbps，动起来才吃带宽，日常最省
#      音频：scrcpy 默认就转发设备音频（实测 opus 48kHz 立体声），参数里已不再禁用；
#            不想要声音加 --no-audio；只想转发但不在电脑出声加 --no-audio-playback
#            -a 单应用模式同样是设备级音频（会从电脑出声），scrcpy 不支持按应用隔离音频
#   应用名模糊匹配：-a 先比对精确包名（快）；否则取「应用名+包名」清单打分：
#      精确包名100 / 精确应用名95 / 应用名前缀85 / 包名末段82 / 包名含点号80 / 包名子串65 / 应用名子串60
#      唯一最高分直接用；多个并列则按匹配度列序号让你选；非交互终端会拒绝并提示用完整包名
#   延迟旋钮：--video-buffer 是本脚本唯一能直接降延迟的开关（+N 毫秒）
#      当前取 0 = 最低延迟（也是 scrcpy 的默认值）
#      12M 档下缓冲影响很小（40s 样本丢帧：0->30、20->22、40->24、60->28、120->17）
#      若无线下觉得跳帧明显，往上调到 40~120；有线链路建议保持 0
#   帧率上限（12M/缓冲40 条件下的同片源 A/B）：48->41.8fps、52->44.0fps、60->45.5fps（CPU 34/32/38%）
#   更安静档：上限改 6M（CPU 约 28%，帧率不变）
#   高画质档（代价大）：加 --video-codec-options=bitrate-mode:int=2 -b 48M --max-fps=60
#      约 55 fps，但 CPU 约 63%、机器温度 68->74 摄氏度，风扇会明显转
#   换档：SCRCPY_ARGS="..." adbctl -S

set -u

ADB="${ADB:-adb}"
PAIR_IP="${PAIR_IP:-pair_ip}"

# -S 时传给 scrcpy 的参数。默认档 = 实测调出来的"帧率够用 + 风扇安静"组合。
# 换档：SCRCPY_ARGS="..." adbctl -S（或用上面注释里的参考档）
SCRCPY_ARGS_DEFAULT="--video-codec=h265 --video-bit-rate=12M --max-size=1200 --max-fps=52 --video-buffer=0"
SCRCPY_ARGS="${SCRCPY_ARGS:-$SCRCPY_ARGS_DEFAULT}"

RE='([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}'
CONN_SVC='_adb-tls-connect._tcp'
PAIR_SVC='_adb-tls-pairing._tcp'

DO_SCRCPY=0
DO_LIST=0
PAIR_CODE=""
WAIT=0
ROUTE=auto
APP=""
APP_SPEC=""
APP_STOP=0
DO_LIST_APPS=0

usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -S|--scrcpy) DO_SCRCPY=1 ;;
    -a|--app)    APP="${2:-}"; DO_SCRCPY=1; shift ;;
    --list-apps) DO_LIST_APPS=1; DO_SCRCPY=1 ;;
    -U|--usb)    ROUTE=usb ;;
    -W|--wifi)   ROUTE=wifi ;;
    -l|--list)   DO_LIST=1; ROUTE=wifi ;;
    -p|--pair)   PAIR_CODE="${2:-}"; ROUTE=wifi; shift ;;
    -w|--wait)   WAIT="${2:-0}"; shift ;;
    -h|--help)   usage; exit 0 ;;
    *) echo "adbctl: 未知参数 '$1'（-h 看用法）" >&2; exit 2 ;;
  esac
  shift
done

case "$WAIT" in ''|*[!0-9]*) echo "adbctl: -w 需要一个秒数" >&2; exit 2 ;; esac

if ! command -v "$ADB" >/dev/null 2>&1 && [ ! -x "$ADB" ]; then
  echo "adbctl: 找不到 adb（可用 ADB=/path/to/adb 指定）" >&2
  exit 127
fi

mdns_raw() { "$ADB" mdns services 2>&1 | tr -d '\r'; }

connect_candidates() {
  mdns_raw | grep -F -- "$CONN_SVC" | grep -oE "$RE"
}

pairing_address() {
  if command -v "$PAIR_IP" >/dev/null 2>&1; then
    "$PAIR_IP" 2>/dev/null
  else
    mdns_raw | grep -F -- "$PAIR_SVC" | grep -oE "$RE" | head -1
  fi
}

# USB 设备序列号：优先看 adb devices -l 里的 " usb:" 标记；
# 退路（极老版本 adb）：非 IP、非 mDNS 别名的本地设备
usb_serial() {
  local u
  u=$("$ADB" devices -l 2>/dev/null | awk '/ usb:/ && $2 == "device" { print $1; exit }')
  if [ -z "$u" ]; then
    u=$("$ADB" devices 2>/dev/null | awk '$2 == "device" && $1 !~ /:/ && $1 !~ /_adb-tls-/ { print $1; exit }')
  fi
  printf '%s' "$u"
}

# ---------- 应用名解析（模糊匹配） ----------

# 剥掉 +（启动前强杀）和 ?（模糊；本脚本默认就是模糊）前缀
parse_app_spec() {
  local s="$1"
  APP_STOP=0
  while :; do
    case "$s" in
      +*) APP_STOP=1; s="${s#+}" ;;
      \?*) s="${s#\?}" ;;
      *) break ;;
    esac
  done
  APP_SPEC="$s"
}

# 输出「包名<TAB>应用名」（依赖 scrcpy --list-apps，约 1~2 秒）
apps_with_labels() {
  scrcpy -s "$1" --list-apps 2>/dev/null < /dev/null | sed -n 's/^ - //p' \
    | awk '{ pkg=$NF; label=$0; sub(/[ \t]+[^ \t]+[ \t]*$/, "", label); print pkg "\t" label }'
}

# stdin 为「包名<TAB>应用名」，$1 为小写查询；输出「分数<TAB>包名<TAB>应用名」，按分数降序
score_apps() {
  awk -v q="$1" '
    {
      pkg=$1; label=$2
      lp=tolower(pkg); ll=tolower(label)
      s=0
      if (lp==q) s=100
      else if (ll==q) s=95
      else if (index(ll,q)==1) s=85
      else {
        n=split(lp, parts, ".")
        if (parts[n]==q) s=82
        else if (index(lp, "." q)>0) s=80
        else if (index(lp, q)>0) s=65
        else if (index(ll, q)>0) s=60
      }
      if (s>0) printf "%d\t%s\t%s\n", s, pkg, label
    }' | sort -k1,1nr
}

# 成功时 stdout 只输出选中的包名；所有提示走 stderr
# 返回：0 唯一命中或已选择 ｜ 1 无匹配 ｜ 2 需选择但不可选/序号无效 ｜ 3 用户取消
resolve_app() {
  local target="$1" q="$2" q_lc exact all top cnt total shown ans
  q_lc=$(printf '%s' "$q" | tr 'A-Z' 'a-z')

  # 1) 精确包名：一次只读查询，最快
  exact=$("$ADB" -s "$target" shell -n pm list packages 2>/dev/null | sed -n 's/^package://p' | grep -ixF -- "$q" | head -1)
  if [ -n "$exact" ]; then
    printf '%s' "$exact"
    return 0
  fi

  # 2) 取「应用名+包名」清单并打分
  echo "adbctl: 正在获取设备应用清单（约 1~2 秒）…" >&2
  all=$(apps_with_labels "$target" | score_apps "$q_lc")
  if [ -z "$all" ]; then
    return 1
  fi

  top=$(printf '%s\n' "$all" | head -1 | cut -f1)
  cnt=$(printf '%s\n' "$all" | awk -F'\t' -v t="$top" '$1==t' | wc -l)
  if [ "$cnt" -eq 1 ]; then
    printf '%s' "$(printf '%s\n' "$all" | head -1 | cut -f2)"
    return 0
  fi

  # 3) 多个并列最高分：列出全部匹配，按匹配度排序，让用户选序号
  total=$(printf '%s\n' "$all" | wc -l)
  if [ ! -t 0 ]; then
    echo "adbctl: 匹配到 $total 个应用，但当前不是交互终端，无法选择。请改用完整包名：" >&2
    printf '%s\n' "$all" | head -30 | awk -F'\t' '{ printf "         %-36s %s\n", $3, $2 }' >&2
    return 2
  fi
  echo "adbctl: 匹配到 $total 个应用（按匹配度排序）:" >&2
  printf '%s\n' "$all" | awk -F'\t' '{ printf "  %2d) %-36s %s\n", NR, $3, $2 }' | head -30 >&2
  shown=$total
  [ "$shown" -gt 30 ] && shown=30
  if [ "$total" -gt 30 ]; then
    echo "        …共 $total 个，上面只显示前 30 个；也可直接输入后续序号，或换更精确的关键词" >&2
  fi
  printf '请输入序号 [1-%d]，q 取消: ' "$shown" >&2
  read -r ans || ans=""
  case "$ans" in
    ''|q|Q) echo "adbctl: 已取消。" >&2; return 3 ;;
    *[!0-9]*) echo "adbctl: 序号无效。" >&2; return 2 ;;
  esac
  if [ "$ans" -lt 1 ] || [ "$ans" -gt "$total" ]; then
    echo "adbctl: 序号超出范围（1-$total）。" >&2
    return 2
  fi
  printf '%s' "$(printf '%s\n' "$all" | sed -n "${ans}p" | cut -f2)"
  return 0
}

launch_or_exit() {
  local target="$1" appargs="" spec pkg rc
  if [ "$DO_LIST_APPS" = 1 ]; then
    exec scrcpy -s "$target" --list-apps
  fi
  if [ -n "$APP" ]; then
    parse_app_spec "$APP"
    spec="$APP_SPEC"
    if [ -z "$spec" ]; then
      echo "adbctl: -a 需要应用名或包名（-h 看用法）" >&2
      exit 2
    fi
    pkg="$(resolve_app "$target" "$spec")"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      if [ "$rc" -eq 1 ]; then
        echo "adbctl: 没有匹配到应用「$spec」。用 adbctl --list-apps 查看全部应用。" >&2
      fi
      exit "$rc"
    fi
    echo "adbctl: 应用已解析 -> $pkg" >&2
    # 若用户在 SCRCPY_ARGS 里自己指定了 --new-display（可带尺寸），尊重用户的，不重复加
    case " $SCRCPY_ARGS " in
      *" --new-display"*) : ;;
      *) appargs="--new-display" ;;
    esac
    if [ "$APP_STOP" = 1 ]; then
      appargs="$appargs --start-app=+$pkg"
    else
      appargs="$appargs --start-app=$pkg"
    fi
    echo "adbctl: 单应用模式：虚拟显示 + 启动 $pkg（手机主屏不受影响）" >&2
  fi
  if [ "$DO_SCRCPY" = 1 ]; then
    echo "adbctl: 启动 scrcpy -s $target $appargs $SCRCPY_ARGS" >&2
    # shellcheck disable=SC2086
    exec scrcpy -s "$target" $appargs $SCRCPY_ARGS
  fi
  exit 0
}

# ---------------- USB 路径 ----------------
if [ "$ROUTE" != wifi ]; then
  usb="$(usb_serial)"
  if [ -n "$usb" ]; then
    echo "adbctl: 检测到 USB 设备，走有线：$usb" >&2
    printf '%s\n' "$usb"
    launch_or_exit "$usb"
  fi
  if [ "$ROUTE" = usb ]; then
    echo "adbctl: -U 指定走 USB，但当前没有在位的 USB 设备。" >&2
    echo "         检查：1) 数据线已插好  2) 手机的『USB 调试』已授权本机" >&2
    exit 1
  fi
  echo "adbctl: 没有 USB 设备，回落到无线调试。" >&2
fi

# ---------------- 无线路径 ----------------
deadline=$(( $(date +%s) + WAIT ))
while :; do
  cands="$(connect_candidates)"
  [ -n "$cands" ] && break
  if [ "$(date +%s)" -lt "$deadline" ]; then sleep 1; continue; fi
  echo "adbctl: 没有发现 $CONN_SVC 广播。检查：" >&2
  echo "         1. 手机【无线调试】已开启（Android 11+）" >&2
  echo "         2. 与电脑同一网段，路由器没开 AP 隔离 / 访客网络隔离" >&2
  echo "         3. 电脑上别跑 avahi-daemon（会和 adb 抢 5353）" >&2
  exit 1
done

if [ "$DO_LIST" = 1 ]; then
  printf '%s\n' "$cands"
  exit 0
fi

# 需要时先配对
if [ -n "$PAIR_CODE" ]; then
  paddr="$(pairing_address)"
  if [ -z "$paddr" ]; then
    echo "adbctl: 没找到配对服务。请在手机上打开『使用配对码配对设备』对话框后重试（-w N 可等待）。" >&2
    exit 1
  fi
  echo "adbctl: 配对 $paddr …" >&2
  # adb pair 自己会往 stdout 打印 "Successfully paired to ..."，必须转进 stderr，
  # 否则会污染本脚本"stdout 只放选中目标"这条约定
  if pair_out="$("$ADB" pair "$paddr" "$PAIR_CODE" 2>&1)"; then
    printf '%s\n' "$pair_out" >&2
  else
    printf '%s\n' "$pair_out" >&2
    echo "adbctl: 配对失败：核对 6 位配对码，并确认配对对话框仍开着。" >&2
    exit 1
  fi
  sleep 1
  cands="$(connect_candidates)"
  if [ -z "$cands" ]; then
    echo "adbctl: 配对成功，但没看到连接服务，请稍后重试连接。" >&2
    exit 1
  fi
fi

# 逐个候选试，成功即停
ok=""
while IFS= read -r a; do
  [ -n "$a" ] || continue
  out="$("$ADB" connect "$a" 2>&1)"
  case "$out" in
    *"connected to"*) printf '%s\n' "$a"; ok="$a"; break ;;
    *) echo "adbctl: $a 不可用（$(printf '%s' "$out" | head -1)）" >&2 ;;
  esac
done <<CANDIDATES
$cands
CANDIDATES

if [ -z "$ok" ]; then
  echo "adbctl: 所有候选地址都连不上。" >&2
  echo "         如果刚开关过无线调试，等几秒再试；必要时在手机上重新配对。" >&2
  exit 1
fi

launch_or_exit "$ok"
